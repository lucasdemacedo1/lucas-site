{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucas-site",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  // Only the public/ folder is served. Everything else in the repo (.git, README, this file) stays private.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
